# ============================================
# HemaTutor - Configuração de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# ============================================
# CHAVES DE API (OBRIGATÓRIO)
# ============================================

# OpenAI API Key (obrigatória para embeddings, mesmo usando Claude)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (necessária apenas se LLM_PROVIDER=anthropic)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# CONFIGURAÇÃO DO LLM
# ============================================

# Provedor do LLM: "openai" ou "anthropic"
LLM_PROVIDER=openai

# Modelo da OpenAI (usado quando LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o

# Modelo da Anthropic (usado quando LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Temperatura do modelo (0.0 = determinístico, 1.0 = criativo)
# Recomendado: 0.3 para conteúdo educacional
LLM_TEMPERATURE=0.3

# Máximo de tokens na resposta
LLM_MAX_TOKENS=4096

# ============================================
# CONFIGURAÇÃO DO VECTORSTORE
# ============================================

# Tipo de VectorStore: "faiss" (local) ou "chroma" (local)
VECTORSTORE_TYPE=faiss

# Modelo de embeddings da OpenAI
# Opções: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# CONFIGURAÇÃO DE CHUNKING
# ============================================

# Tamanho do chunk em caracteres (recomendado: 1000-1500)
CHUNK_SIZE=1200

# Overlap entre chunks (recomendado: 200-300)
CHUNK_OVERLAP=250

# ============================================
# CONFIGURAÇÃO DE RAG
# ============================================

# Número de chunks retornados na busca (recomendado: 4-8)
RETRIEVER_K=6

# Score mínimo de similaridade (0.0 a 1.0)
SIMILARITY_THRESHOLD=0.5

# ============================================
# CONFIGURAÇÃO DO QUIZ
# ============================================

# Número de questões por quiz
QUESTIONS_PER_QUIZ=3

# Número de alternativas por questão
OPTIONS_PER_QUESTION=4
