# ============================================
# HemaTutor - Configuração de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# ============================================
# CHAVES DE API
# ============================================
# NOTA: Se usar EMBEDDING_PROVIDER=local, NÃO precisa de OPENAI_API_KEY!
# Só precisa da chave do LLM que você vai usar (OpenAI OU Anthropic)

# OpenAI API Key (necessária se LLM_PROVIDER=openai OU EMBEDDING_PROVIDER=openai)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (necessária se LLM_PROVIDER=anthropic)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# CONFIGURAÇÃO DO LLM
# ============================================

# Provedor do LLM: "openai" ou "anthropic"
# Use "anthropic" para usar Claude (recomendado!)
LLM_PROVIDER=anthropic

# Modelo da OpenAI (usado quando LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o

# Modelo da Anthropic (usado quando LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Temperatura do modelo (0.0 = determinístico, 1.0 = criativo)
# Recomendado: 0.3 para conteúdo educacional
LLM_TEMPERATURE=0.3

# Máximo de tokens na resposta
LLM_MAX_TOKENS=4096

# ============================================
# CONFIGURAÇÃO DO VECTORSTORE
# ============================================

# Tipo de VectorStore: "faiss" (local) ou "chroma" (local)
VECTORSTORE_TYPE=faiss

# ============================================
# CONFIGURAÇÃO DE EMBEDDINGS
# ============================================

# Provedor de embeddings: "local" (GRATUITO!) ou "openai"
# "local" usa HuggingFace sentence-transformers - NÃO PRECISA DE API KEY!
# "openai" usa OpenAI embeddings - precisa de OPENAI_API_KEY
EMBEDDING_PROVIDER=local

# Modelo de embeddings local (usado se EMBEDDING_PROVIDER=local)
# all-MiniLM-L6-v2: rápido e leve (~90MB) - RECOMENDADO
# all-mpnet-base-v2: melhor qualidade (~420MB)
EMBEDDING_MODEL_LOCAL=all-MiniLM-L6-v2

# Modelo de embeddings OpenAI (usado se EMBEDDING_PROVIDER=openai)
# Opções: text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# CONFIGURAÇÃO DE CHUNKING
# ============================================

# Tamanho do chunk em caracteres (recomendado: 1000-1500)
CHUNK_SIZE=1200

# Overlap entre chunks (recomendado: 200-300)
CHUNK_OVERLAP=250

# ============================================
# CONFIGURAÇÃO DE RAG
# ============================================

# Número de chunks retornados na busca (recomendado: 4-8)
RETRIEVER_K=6

# Score mínimo de similaridade (0.0 a 1.0)
SIMILARITY_THRESHOLD=0.5

# ============================================
# CONFIGURAÇÃO DO QUIZ
# ============================================

# Número de questões por quiz
QUESTIONS_PER_QUIZ=3

# Número de alternativas por questão
OPTIONS_PER_QUESTION=4
