# ============================================
# HemaTutor - .gitignore
# ============================================

# Ambiente Python
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Variáveis de ambiente (IMPORTANTE: nunca commitar!)
.env
.env.local
.env.*.local

# Dados do usuário
data/uploads/*
data/vectorstores/*
!data/uploads/.gitkeep
!data/vectorstores/.gitkeep

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db

# Jupyter Notebooks
.ipynb_checkpoints/

# Logs
*.log
logs/

# Testes
.pytest_cache/
.coverage
htmlcov/

# Streamlit
.streamlit/secrets.toml
