# ============================================
# ASH-SAP Study Platform - Configuração
# ============================================
# Copie para .env e configure sua API key

# API Key da Anthropic (OBRIGATÓRIO)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo Claude (opcional)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Configurações de geração
TEMPERATURE=0.3
MAX_TOKENS=4096

# Configurações pedagógicas
QUESTIONS_PER_LESSON=5
PASSING_SCORE=0.7
REVIEW_INTERVAL_DAYS=7
